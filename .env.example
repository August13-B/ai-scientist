# ===== 阿里云百炼平台（必填）=====
# 控制台：https://bailian.console.aliyun.com/
ALIYUN_BAILIAN_API_KEY=your-bailian-api-key
# 模型名（百炼平台模型标识）
QWEN_MODEL=qwen-max
QWEN_LIGHT_MODEL=qwen-plus
QWEN_TURBO_MODEL=qwen-turbo

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_scientist
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# ===== 向量数据库 =====
# RAG_MOCK_SAMPLES=true：本地调试模式，不连向量库，RagSearchService 返回内置样例论文（DOI 真实可过引用核验）
# 开发环境使用 Chroma，生产切换 Milvus
VECTOR_DB=chroma          # chroma | milvus
CHROMA_HOST=localhost
CHROMA_PORT=8000
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Embedding（百炼 DashScope API，灌库脚本用）=====
EMBEDDING_PROVIDER=dashscope   # 当前仅支持 dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ===== 服务端口 =====
BACKEND_PORT=8080
AI_SERVICE_PORT=8081
FRONTEND_PORT=5173
